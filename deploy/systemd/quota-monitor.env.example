# Start in shadow mode. Change to 0 only after comparing at least 24 hours of output.
QUOTA_MONITOR_SHADOW=1
QUOTA_MONITOR_INTERVAL_SECONDS=20
QUOTA_MONITOR_JITTER_SECONDS=3

# Notification secrets (configure only the channels you use).
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
FEISHU_WEBHOOK_URL=
WECOM_WEBHOOK_URL=

# Optional signed wake-up bridge to hkid-appointment-monitor.
# Loopback HTTP is accepted when both services run on the same server.
HKID_RELEASE_WEBHOOK_URL=http://127.0.0.1:8765/internal/reschedule/release-signals/quota-monitor
HKID_RELEASE_WEBHOOK_SECRET=
HKID_RELEASE_WEBHOOK_TIMEOUT_SECONDS=10
HKID_RELEASE_WEBHOOK_MAX_ATTEMPTS=3
HKID_RELEASE_WEBHOOK_BACKOFF_SECONDS=1
