{
  "api": {
    "svc_id": 579,
    "timeout": 30
  },

  "offices": {
    "FTO": "火炭办事处",
    "RHK": "港岛办事处",
    "RKO": "九龙办事处",
    "RTK": "将军澳办事处",
    "TMO": "屯门办事处",
    "YLO": "元朗办事处"
  },

  "date_range": {
    "start": null,
    "end": null
  },

  "notifications": {
    "feishu": {
      "enabled": true,
      "app_id": "cli_xxxxxxxxxxxxx",
      "app_secret": "YOUR_APP_SECRET",
      "chat_id": "oc_xxxxxxxxxxxxxxxxxxxxx",
      "webhook_url": "",
      "min_interval_minutes": 10
    },
    "wecom": {
      "enabled": false,
      "webhook_url": "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_BOT_KEY"
    },
    "email": {
      "enabled": false,
      "smtp_username": "your-qq-email@qq.com",
      "smtp_password": "YOUR_QQ_SMTP_AUTH_CODE",
      "subscribers": [
        "your-email@example.com"
      ],
      "min_interval_minutes": 30
    }
  },

  "retry": {
    "max_retries": 3,
    "backoff_base_seconds": 5
  },

  "daemon": {
    "interval_seconds": 20,
    "jitter_seconds": 3,
    "failure_backoff_base_seconds": 30,
    "failure_backoff_max_seconds": 900,
    "shadow": true
  },

  "log": {
    "level": "INFO",
    "file": "monitor.log",
    "max_size_mb": 10,
    "backup_count": 3
  }
}
